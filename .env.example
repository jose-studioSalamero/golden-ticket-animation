# Copy to .env and fill in Mailchimp to use the live list.
# Without MAILCHIMP_API_KEY the prototype stores players in .data/players.json.

SESSION_SECRET=change-me-in-production

# Mailchimp (optional). Defaults match the Webflow hosted form:
# https://gmail.us19.list-manage.com/subscribe/post?u=...&id=263b1eb688
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us19
MAILCHIMP_LIST_ID=263b1eb688

# 0.01% golden ticket, otherwise 5% off tickets.
# Set to 1 to always draw the Golden Ticket while testing.
PRIZE_GOLDEN_RATE=0.0001
